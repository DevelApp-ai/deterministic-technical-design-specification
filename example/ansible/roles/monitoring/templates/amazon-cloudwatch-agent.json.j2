{# roles/monitoring/templates/amazon-cloudwatch-agent.json.j2 #}
{# CloudWatch agent configuration — collected metrics and log files.     #}
{# Satisfies DORA Art.10 (continuous monitoring) and CIS Control 8.      #}
{
  "agent": {
    "metrics_collection_interval": {{ monitoring_metrics_interval }},
    "run_as_user": "root",
    "logfile": "/opt/aws/amazon-cloudwatch-agent/logs/amazon-cloudwatch-agent.log"
  },
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/messages",
            "log_group_name": "{{ monitoring_log_group_system }}",
            "log_stream_name": "{instance_id}/messages",
            "retention_in_days": {{ monitoring_log_retention }},
            "timestamp_format": "%b %d %H:%M:%S"
          },
          {
            "file_path": "/var/log/syslog",
            "log_group_name": "{{ monitoring_log_group_system }}",
            "log_stream_name": "{instance_id}/syslog",
            "retention_in_days": {{ monitoring_log_retention }},
            "timestamp_format": "%b %d %H:%M:%S"
          },
          {
            "file_path": "/var/log/audit/audit.log",
            "log_group_name": "{{ monitoring_log_group_audit }}",
            "log_stream_name": "{instance_id}/audit",
            "retention_in_days": {{ monitoring_log_retention }},
            "timestamp_format": "%s"
          },
          {
            "file_path": "/var/log/secure",
            "log_group_name": "{{ monitoring_log_group_audit }}",
            "log_stream_name": "{instance_id}/secure",
            "retention_in_days": {{ monitoring_log_retention }},
            "timestamp_format": "%b %d %H:%M:%S"
          },
          {
            "file_path": "/var/log/auth.log",
            "log_group_name": "{{ monitoring_log_group_audit }}",
            "log_stream_name": "{instance_id}/auth",
            "retention_in_days": {{ monitoring_log_retention }},
            "timestamp_format": "%b %d %H:%M:%S"
          },
          {
            "file_path": "/var/log/application/*.log",
            "log_group_name": "{{ monitoring_log_group_app }}",
            "log_stream_name": "{instance_id}/app",
            "retention_in_days": {{ monitoring_log_retention }}
          }
        ]
      }
    },
    "log_stream_name": "{instance_id}"
  },
  "metrics": {
    "namespace": "DTDS/EC2",
    "append_dimensions": {
      "InstanceId": "${aws:InstanceId}",
      "InstanceType": "${aws:InstanceType}",
      "AutoScalingGroupName": "${aws:AutoScalingGroupName}"
    },
    "metrics_collected": {
      "cpu": {
        "measurement": [
          "cpu_usage_idle",
          "cpu_usage_user",
          "cpu_usage_system",
          "cpu_usage_iowait"
        ],
        "metrics_collection_interval": {{ monitoring_metrics_interval }},
        "totalcpu": true
      },
      "disk": {
        "measurement": [
          "used_percent",
          "inodes_free",
          "disk_used_percent"
        ],
        "metrics_collection_interval": {{ monitoring_metrics_interval }},
        "resources": {{ monitoring_disk_mounts | to_json }}
      },
      "mem": {
        "measurement": [
          "mem_used_percent",
          "mem_available_percent"
        ],
        "metrics_collection_interval": {{ monitoring_metrics_interval }}
      },
      "netstat": {
        "measurement": [
          "tcp_established",
          "tcp_time_wait",
          "tcp_close_wait"
        ],
        "metrics_collection_interval": {{ monitoring_metrics_interval }}
      },
      "processes": {
        "measurement": [
          "running",
          "sleeping",
          "total"
        ],
        "metrics_collection_interval": {{ monitoring_metrics_interval }}
      },
      "swap": {
        "measurement": [
          "swap_used_percent"
        ],
        "metrics_collection_interval": {{ monitoring_metrics_interval }}
      }
    }
  }
}
