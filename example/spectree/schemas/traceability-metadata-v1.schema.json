{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "traceability-metadata-v1",
  "title": "Shared traceability metadata envelope (version 1)",
  "description": "Stable, versioned contract for the normalized cross-format traceability graph emitted by scripts/normalize-traceability-metadata.py. All node ids are namespace-qualified (see spectree/id-namespaces.json). Versioned independently of the vendored grammars.",
  "$defs": {
    "Compliance": {
      "type": "object",
      "required": ["framework", "refs"],
      "additionalProperties": false,
      "properties": {
        "framework": {"type": "string", "minLength": 1},
        "refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "description": {"type": ["string", "null"]}
      }
    },
    "RequirementNode": {
      "type": "object",
      "required": ["id", "type", "title", "source", "moscow"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"enum": ["requirement"]},
        "title": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "moscow": {"enum": ["must", "should", "could", "wont"]},
        "category": {"type": "string", "minLength": 1},
        "evidence": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "AdrNode": {
      "type": "object",
      "required": ["id", "type", "title", "source", "status", "date"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^adr:ADR-[0-9]{4}$"},
        "type": {"enum": ["adr"]},
        "title": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "status": {"enum": ["Accepted", "Proposed", "Deprecated", "Superseded"]},
        "date": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"},
        "author": {"type": "string", "minLength": 1},
        "supersedes": {
          "type": "array",
          "items": {"type": "string", "pattern": "^adr:ADR-[0-9]{4}$"}
        },
        "relatedRequirements": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "evidence": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "PolicyNode": {
      "type": "object",
      "required": ["id", "type", "title", "source", "severity"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"enum": ["policy"]},
        "title": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "severity": {"type": "string", "minLength": 1},
        "package": {"type": "string", "minLength": 1},
        "relatedAdr": {
          "type": "array",
          "items": {"type": "string", "pattern": "^adr:ADR-[0-9]{4}$"}
        },
        "relatedRequirements": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "compliesWith": {
          "type": "array",
          "items": {"$ref": "#/$defs/Compliance"}
        }
      }
    },
    "ComponentNode": {
      "type": "object",
      "required": ["id", "type", "title", "source", "satisfies", "relatedAdr"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"enum": ["component"]},
        "title": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "namespace": {"type": "string", "minLength": 1},
        "version": {"type": ["string", "null"]},
        "dependencies": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "satisfies": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "relatedAdr": {
          "type": "array",
          "items": {"type": "string", "pattern": "^adr:ADR-[0-9]{4}$"}
        },
        "evidence": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "TestSuiteNode": {
      "type": "object",
      "required": ["id", "type", "title", "source", "target", "covers"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"enum": ["test-suite"]},
        "title": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "covers": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "NfrNode": {
      "type": "object",
      "required": ["id", "type", "title", "source", "kind"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"enum": ["nfr"]},
        "title": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "bound": {"type": "object"},
        "relatedAdr": {
          "type": "array",
          "items": {"type": "string", "pattern": "^adr:ADR-[0-9]{4}$"}
        }
      }
    },
    "SystemNode": {
      "type": "object",
      "required": ["id", "type", "title", "source", "appliesTo"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "type": {"enum": ["system"]},
        "title": {"type": "string", "minLength": 1},
        "source": {"type": "string", "minLength": 1},
        "appliesTo": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "compliesWith": {
          "type": "array",
          "items": {"$ref": "#/$defs/Compliance"}
        }
      }
    },
    "Node": {
      "oneOf": [
        {"$ref": "#/$defs/RequirementNode"},
        {"$ref": "#/$defs/AdrNode"},
        {"$ref": "#/$defs/PolicyNode"},
        {"$ref": "#/$defs/ComponentNode"},
        {"$ref": "#/$defs/TestSuiteNode"},
        {"$ref": "#/$defs/NfrNode"},
        {"$ref": "#/$defs/SystemNode"}
      ]
    },
    "Edge": {
      "type": "object",
      "required": ["from", "type", "to"],
      "additionalProperties": false,
      "properties": {
        "from": {"type": "string", "minLength": 1},
        "type": {
          "enum": ["references", "implements", "satisfies", "covers", "supersedes", "traces"]
        },
        "to": {"type": "string", "minLength": 1}
      }
    },
    "DanglingEdge": {
      "type": "object",
      "required": ["from", "type", "to", "missing"],
      "additionalProperties": false,
      "properties": {
        "from": {"type": "string", "minLength": 1},
        "type": {"enum": ["references", "implements", "satisfies", "covers", "supersedes", "traces"]},
        "to": {"type": "string", "minLength": 1},
        "missing": {"type": "string", "minLength": 1}
      }
    }
  },
  "type": "object",
  "required": ["schema", "schemaVersion", "generated", "nodes", "edges", "integrity"],
  "additionalProperties": false,
  "properties": {
    "schema": {"enum": ["traceability-metadata"]},
    "schemaVersion": {"enum": [1]},
    "generated": {
      "type": "object",
      "required": ["normalizer", "status", "nodeCount", "edgeCount"],
      "additionalProperties": false,
      "properties": {
        "normalizer": {"type": "string", "minLength": 1},
        "status": {"type": "string", "minLength": 1},
        "nodeCount": {"type": "integer"},
        "edgeCount": {"type": "integer"},
        "namespaces": {
          "type": "object"
        }
      }
    },
    "nodes": {
      "type": "array",
      "items": {"$ref": "#/$defs/Node"}
    },
    "edges": {
      "type": "array",
      "items": {"$ref": "#/$defs/Edge"}
    },
    "integrity": {
      "type": "object",
      "required": ["duplicateIds", "danglingEdges"],
      "additionalProperties": false,
      "properties": {
        "duplicateIds": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "danglingEdges": {
          "type": "array",
          "items": {"$ref": "#/$defs/DanglingEdge"}
        }
      }
    }
  }
}
